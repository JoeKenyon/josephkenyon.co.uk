  <header>
    <a href="/">{{ meta.siteName }}</a>
    <nav>
      {%- for entry in collections.all | eleventyNavigation %}
        <a href="{{ entry.url }}"
            {% if entry.url == page.url %} 
                aria-current="page"
            {% endif %}>
        {{ entry.title }}
        </a>
      {%- endfor %}
    </nav>
  </header>