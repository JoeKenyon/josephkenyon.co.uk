<header class="site-header">

  <a href="/" id="joe" class="site-logo">
    {% image "./public/kesagians.svg", "joe logo" %}
  </a>

  <nav class="site-nav">

    {% for entry in collections.all | eleventyNavigation %}

      <a href="{{ entry.url }}"
        class="site-nav-link"
        {% if entry.url == page.url %} 
          aria-current="page"
        {% endif %}

      >
        {{ entry.title }}
      </a>
    
    {% endfor %}

  </nav>
</header>

<style>
#joe
{
  --logo-size: 2.5rem;

  background-color: transparent;
  transition: all 0.2s ease;

  &:hover, 
  &:focus,
  &:active 
  {
    opacity: 0.8;
    scale: 1.02;
  }

  picture
  {
    height: var(--logo-size);
    display: flex;

    img
    {
      object-fit: contain;
      height: 100%;
      width: auto;

    }
  }
}
</style>