---
layout: base.njk
---
<div class="page-title-wrapper">
    <h1 class="page-title">{{ title }}</h1>
</div>

<article class="page-content">

    {% if thumbnail %}
        <figure class="album-cover">
            {% image thumbnail, title %}
        </figure>
    {% endif %}

    <div class="music-tracks">

        {% for track in tracks %}

            <iframe 
            class="music-track-iframe" 
            src="https://bandcamp.com/EmbeddedPlayer/track={{track.id}}/size=medium/linkcol=333333/bgcol=ffffff/transparent=true/"
            loading="lazy"
            ></iframe>

        {% endfor %}

    </div>
</article>

{% include 'components/postNavigation.njk' %}

<style>
.album-cover-wrapper
{
    margin: 0;
}
.album-cover
{
        
    width: 100%;
    max-height: 50svh;
    aspect-ratio: 1/1;
    height: 100%;

    padding-bottom: var(--vspace);

    margin: 0;

    picture
    {   
        width: 100%;
        display: flex;
    }

    display: flex;

    img
    {
        object-fit: contain;
        max-width: 100%;
        max-height: 100%;
        width: fit-content;
        margin: 0 auto;
    }

}
.music-tracks
{
    display: flex;
    flex-direction: column;

    gap: var(--vspace);

    width: 100%;

    .music-track-iframe
    {
        max-height: 120px;
        max-width: 700px;
        height: 100%;
        width: 100%;
        margin: 0 auto;
        border: none;
    }
}
</style>

