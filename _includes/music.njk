---
layout: base.njk
---
<h1>{{ title }}</h1>

<article>

    {% if thumbnail %}

        <p>
            <figure id="albumCover">
                {% image thumbnail, title %}
            </figure>
        </p>
        
    {% endif %}

    <div id="tracks">

        {% for track in tracks %}

            <iframe 
            class="w-full h-full shadowBox rounded-none border-none max-w-[700px] max-h-[120px]" 
            src="https://bandcamp.com/EmbeddedPlayer/track={{track.id}}/size=medium/linkcol=333333/bgcol=ffffff/transparent=true/"
            loading="lazy"
            ></iframe>

        {% endfor %}

    </div>
    
    {{ content | safe }}
</article>

{% include 'components/postNavigation.njk' %}

<style>
#albumCover
{
        
    width: 100%;
    max-height: 50svh;
    aspect-ratio: 1/1;
    height: 100%;

    margin: 0;

    picture
    {   
        width: 100%;
        display: flex;
    }

    display: flex;

    img
    {
        object-fit: contain;
        max-width: 100%;
        max-height: 100%;
        width: fit-content;
        margin: 0 auto;
    }

}
#tracks
{
    display: flex;
    flex-direction: column;

    gap: var(--vspace);

    width: 100%;

    iframe
    {
        max-height: 120px;
        max-width: 700px;
        height: 100%;
        width: 100%;
        margin: 0 auto;
        border: none;
    }
}
</style>

