<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
  </head>
  <body>
    
    <header>
      <a href="{{ '/' | url }}"><img class="logo" src="/g36.png" alt="logo"></a>
    </header>

    <main>
    <h1>{{title}}</h1>
    {% if video %}
      <div class="eleventy-plugin-youtube-embed" style="position:relative;width:100%;padding-top: 56.25%;">
        <iframe style="position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;" 
        width="100%" height="100%" frameborder="0" 
        title="{{ title }}" 
        src="{{ video }}" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen="">
        </iframe>
      </div>
    {% endif %}
      {{ content | safe }}
    </main>

    <footer>
      <ul>
        <li><a href="mailto:joekenyon72@gmail.com" target="_blank">Email</a></li>
        <li><a href="https://www.youtube.com/@joekenyon" target="_blank">YouTube</a></li>
        <li><a href="https://joekenyon72.bandcamp.com" target="_blank">Bandcamp</a></li>
      </ul>
    </footer>
    
  </body>
</html>