<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
  </head>
  <body>

    <header>
      <a href="{{ '/' | url }}"><img class="logo" src="/g36.png" alt="logo"></a>
    </header>

    <main class="art-tiles-main">
        <div class="art-tiles">
            {{ content | safe }}
            {% for image in collections.artImages %}
                <img src="{{ image.url }}" alt="{{ image.alt }}" loading="lazy" decoding="async">
            {% endfor %}
        </div>
    </main>
    
  </body>
</html>