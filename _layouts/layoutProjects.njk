<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
  </head>
  <body>

    <header>
    <a href="{{ '/' | url }}"><img class="logo" src="/g36.png" alt="logo"></a>
    <nav>
    <a href="/projects" {% if page.url == '/' or page.url.startsWith('/projects') %}class="active"{% endif %}>projects</a>
    <a href="/art" {% if page.url.startsWith('/art') %}class="active"{% endif %}>art</a>
    <a href="/music" {% if page.url.startsWith('/music') %}class="active"{% endif %}>music</a>
    </nav>
    </header>
    
    <main>
        <section id="projects" class="home-section">
          <ul class="post-list">
          {% for project in collections.projects %}
          <li class="{% if project.data.external %}is-external{% else %}is-writeup{% endif %}">
          {% if project.data.external %}
          <a href="{{ project.url }}" target="_blank" rel="noopener">{{ project.data.title | lower }} ↗</a>
          {% else %}
          <a href="{{ project.url }}">{{ project.data.title | lower }}</a>
          {% endif %}
          </li>
          {% endfor %}
          </ul>
        </section>
    </main>
    
  </body>
</html>