---
title: Piano
---
{% set octave = [
    { note: 'C4', midi: 60, key: 'a', type: 'white' },
    { note: 'C#4', midi: 61, key: 'w', type: 'black', offset: 1 },
    { note: 'D4', midi: 62, key: 's', type: 'white' },
    { note: 'D#4', midi: 63, key: 'e', type: 'black', offset: 2 },
    { note: 'E4', midi: 64, key: 'd', type: 'white' },
    { note: 'F4', midi: 65, key: 'f', type: 'white' },
    { note: 'F#4', midi: 66, key: 't', type: 'black', offset: 4 },
    { note: 'G4', midi: 67, key: 'g', type: 'white' },
    { note: 'G#4', midi: 68, key: 'y', type: 'black', offset: 5 },
    { note: 'A4', midi: 69, key: 'h', type: 'white' },
    { note: 'A#4', midi: 70, key: 'u', type: 'black', offset: 6 },
    { note: 'B4', midi: 71, key: 'j', type: 'white' },
    { note: 'C5', midi: 72, key: 'k', type: 'white' }
] %}

<div class="piano-wrapper">
    <div class="piano-keyboard" id="web-piano">
        {% for k in octave %}
            {% if k.type == 'white' %}
                <button class="piano-key white-key" data-midi="{{ k.midi }}" data-key="{{ k.key }}" aria-label="Play {{ k.note }}">
                    <span class="key-label">{{ k.key | upper }}</span>
                </button>
            {% else %}
                <button class="piano-key black-key" data-midi="{{ k.midi }}" data-key="{{ k.key }}" aria-label="Play {{ k.note }}" style="left: calc({{ k.offset }} * (100% / 8) - 3%);"></button>
            {% endif %}
        {% endfor %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => 
{
    let audioCtx;
    const keys = document.querySelectorAll('.piano-key');

    const playNote = (midiNote, keyElement) => 
    {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const frequency = 440 * Math.pow(2, (midiNote - 69) / 12);
        
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(frequency, audioCtx.currentTime);

        const attackTime = 0.02;
        const decayTime = 1.5;

        gain.gain.setValueAtTime(0, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.8, audioCtx.currentTime + attackTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + attackTime + decayTime);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + attackTime + decayTime);

        // handle the visual state
        keyElement.classList.add('active');
        setTimeout(() => keyElement.classList.remove('active'), 150);
    };

    // map mouse clicks
    keys.forEach(key => 
    {
        key.addEventListener('mousedown', () => 
        {
            playNote(parseInt(key.dataset.midi), key);
        });
    });

    // map hardware keyboard presses
    window.addEventListener('keydown', (e) => 
    {
        if (e.repeat) return; 
        
        const keyEl = document.querySelector(`.piano-key[data-key="${e.key.toLowerCase()}"]`);
        if (keyEl) 
        {
            playNote(parseInt(keyEl.dataset.midi), keyEl);
        }
    });
});
</script>

<style>
.piano-wrapper 
{
    width: 100%;
    margin: var(--article-h1-vspace) auto;
}

.piano-keyboard 
{
    position: relative;
    display: flex;
    height: 200px;
    width: 100%;
}

.piano-key 
{
    cursor: pointer;
    border: 1px solid var(--text-color);
    transition: background-color 0.1s ease;
    padding: 0;
}

.white-key 
{
    flex: 1;
    position: relative;
    z-index: 0;
    background-color: var(--background-color);
}

.white-key:hover, 
.white-key.active 
{
    background-color: var(--text-color-muted);
}

.white-key .key-label 
{
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-vcr);
    font-size: 0.75rem;
}

.black-key 
{
    position: absolute;
    z-index: 10;
    width: 6%;
    height: 60%;
    background-color: var(--link-background-color);
}

.black-key:hover, 
.black-key.active 
{
    background-color: var(--link-text-color-active);
}
</style>