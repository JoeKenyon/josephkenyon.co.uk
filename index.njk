---
layout: base.njk
title: "Home"
---
<header>
    <h1>Projects</h1>
</header>

<ul>
    {%- for p in collections.projects %}
        {%- set ext = p.data.external %}
        {%- set targetUrl = p.data.url or p.url %}
        <li class="{{ 'is-external' if ext else 'is-writeup' }}">
        <a href="{{ targetUrl }}"{% if ext %} target="_blank" rel="noopener"{% endif %}>{{ p.data.title | lower }}{% if ext %} ↗{% endif %}</a>
        </li>
    {%- endfor %}
</ul>