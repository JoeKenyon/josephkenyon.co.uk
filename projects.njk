---
layout: base.njk
title: "Projects"
---
<header>
    <h1>{{ title }}</h1>
</header>

<ul>
    {%- for p in collections.projects %}
        {%- set extUrl = p.data.external %}
        {%- set targetUrl = extUrl or p.url %}
        <li class="{{ 'is-external' if extUrl else 'is-writeup' }}">
        <a href="{{ targetUrl }}"{% if extUrl %} target="_blank" rel="noopener"{% endif %}>{{ p.data.title | lower }}{% if extUrl %} ↗{% endif %}</a>
        </li>
    {%- endfor %}
</ul>