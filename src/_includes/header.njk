<header>
  <a href="{{ '/' | url }}"><img class="logo" src="/joe-sig-gen.png" alt="home"></a>
  <nav>
  {%- set here = page.url or "" %}
  {%- for item in nav %}
    {%- set isProjects = item.url and item.url.includes('projects') %}
    {%- if isProjects %}
      {%- set active = (here == '/' or here.startsWith(item.url)) %}
    {%- else %}
      {%- set active = (here == item.url) if item.url == '/' else here.startsWith(item.url) %}
    {%- endif %}
    <a href="{{ item.url | url }}"{% if active %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
  {%- endfor %}
  </nav>
</header>