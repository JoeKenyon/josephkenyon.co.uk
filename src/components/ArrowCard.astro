---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
---

<a href={`/${entry.collection}/${entry.id}`} class="flex items-center justify-between p-4 px-5 bg-white/5 border border-white/5 transition-all duration-300 ease-in-out no-underline h-full hover:bg-white/[0.06] hover:border-accent group">
  <div class="flex flex-col gap-1 min-w-0">
    <div class="text-sm font-semibold text-white tracking-tight">
      {entry.data.title}
    </div>
    <div class="text-[11px] text-white/50 truncate">
      {entry.data.description}
    </div>
  </div>
  <div class="flex items-center justify-center ml-4 text-accent">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 24 24"
      class="w-5 h-5 stroke-[2.5] fill-none stroke-current">
      <line x1="5" y1="12" x2="19" y2="12" class="translate-x-[10px] scale-0 transition-all duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-100" />
      <polyline points="12 5 19 12 12 19" class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0" />
    </svg>
  </div>
</a>