---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  imageAsset: any;
  loading?: "eager" | "lazy";
}

const { id, title, imageAsset, loading = "lazy" } = Astro.props;
---

<div class="break-inside-avoid">
  <a href={`/art/${id}`} class="hover:invert-100 invert-0 shadowBox transition-all duration-200 block">
    <Image 
      src={imageAsset} 
      alt={title}
      width={400}
      loading={loading}
      class="w-full h-auto"
    />
  </a>
</div>
