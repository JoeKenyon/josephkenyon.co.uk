---
interface Props {
  prev: string;
  next: string;
}

const { prev, next } = Astro.props;
---

<div class="flex justify-between items-center text-xl max-w-xl w-full shrink-0 mx-auto z-20 mb-5">
  <a href={`/art/${prev}`} class="hover:underline text-accent shadowBox bg-white">← Previous</a>
  <a href={`/art/${next}`} class="hover:underline text-accent shadowBox bg-white">Next →</a>
</div>
