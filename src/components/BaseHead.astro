---
import "@styles/global.css"

type Props = { title: string; }
const { title } = Astro.props;

const keywords = "";
const description = "";
---

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Joseph Kenyon | {title} </title>
  <meta name="author" content="Joseph Kenyon">
  <meta name="keywords" content={keywords}>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/kesagians.svg">
  <link rel="icon" type="image/x-icon" href="/kesagians.svg">		
  <link href="https://unpkg.com/prismjs@1.20.0/themes/prism-tomorrow.css" rel="stylesheet"/>
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
</head>