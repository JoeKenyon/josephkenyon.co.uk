    <div class="sm:flex sm:flex-row sm:w-fit justify-around flex-wrap flex flex-row sm:flex-nowrap lowercase gap-4 mx-auto">
        {pages.map((page) => (
            <a href={page.url} class="
            bg-white 
            shadow-[5px_-5px_0px_0px_black]
            hover:text-red-600">
                {page.name}
            </a>
        ))}
    </div>
</footer>