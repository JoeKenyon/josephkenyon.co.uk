---
const socials = [
    ["Email", "mailto:joekenyon72@gmail.com"],
    ["LinkedIn", "https://www.linkedin.com/in/joe-kenyon/"],
    ["Instagram", "https://instagram.com/kenyon_joe"],
    ["GitHub", "https://github.com/JoeKenyon"]
];

import { Icons } from "src/config/icons";
---
<footer class="site-footer">
    <span class="site-footer-copy">
        &copy; Joseph Kenyon
    </span>

    <div class="site-footer-socials">
        {socials.map((link) => (<a href={link[1]} aria-label={link[0]}>
            <Fragment set:html={Icons[link[0]]}/>
        </a>))}
    </div>
</footer>