---
import "@styles/global.css"
type Props = { title: string; }
const { title } = Astro.props;
import ClientRouter from "astro/components/ClientRouter.astro";
---
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/kesagians.svg">
<link rel="icon" type="image/x-icon" href="/kesagians.svg">
<meta name="generator" content={Astro.generator} />
<meta name="description" content="Offical portfolio of Joseph Kenyon. Artist, musician, and developer.">
<title>JOE_SITE | {title}</title>
<ClientRouter/>
</head>