---
import Container from "@components/Container.astro";

const pages = [
  { name: "home", href: "/" },
  { name: "projects", href: "/projects" },
  { name: "art", href: "/art" },
  { name: "music", href: "/music" },
];

const pathname = new URL(Astro.url).pathname;
const isActive = (path: string) => 
    path === "/" ? pathname === "/" : pathname.startsWith(path);
---

<header class="py-6 sticky top-0 z-50 bg-black/80 backdrop-blur-md border-b border-white/5">
  <Container>
    <nav class="flex items-center justify-between">


      <a href="/" class="text-sm font-bold tracking-tighter hover:text-accent transition-colors flex flex-row gap-4">
       <img src="/kesagians.svg" class="w-10"> JOSEPH KENYON
      </a>
      
      <div class="flex items-center gap-1 md:gap-4">
        {pages.map((page, index) => (
          <>
            <a 
              href={page.href} 
              class={`text-[11px] md:text-xs uppercase tracking-[0.2em] transition-colors hover:text-accent ${isActive(page.href) ? "text-accent font-bold" : "text-white/60"}`}
            >
              {page.name}
            </a>
            {index < pages.length - 1 && (
              <span class="text-white/10 text-[10px]">/</span>
            )}
          </>
        ))}
      </div>
    </nav>
  </Container>
</header>
