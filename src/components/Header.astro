---
import { Image } from 'astro:assets';
import headerImage from "@assets/imgs/penis 2.png";
const pages = [
    ["Home", "/"],
    ["Projects", "/projects"],
    ["Art", "/art"],
    ["Music", "/music"],  
    ["About", "/about"]
];
---
<header class="site-header">
  <a href="/" class="site-logo">
    <Image class="site-logo-img" src={headerImage} width={220} alt="Joe Logo"/>
  </a>
  <button id="site-nav-toggle" style="display: none">{"+"}</button>
  <nav class="site-nav">
    {
      pages.map((page) => ( <a href={page[1]} aria-label={page[0]} class="site-nav-link">{page[0]}</a>))
    }
  </nav>
</header>