---
interface Props {
  title: string;
  viewAllHref: string;
}

const { title, viewAllHref } = Astro.props;
---

<section class="flex flex-col gap-0 mb-10">
  <div class="flex items-end justify-between mb-0 p-0 m-0">
    <div class="flex items-end gap-4">
      <div class="w-15">
        <slot name="icon" />
      </div>
      <h2 class="text-7xl leading-13 font-bolder italic tracking-tighter m-0">{title}</h2>
    </div>
    <a href={viewAllHref} class="text-accent hover:underline">View all →</a>
  </div>

  <div class="relative group">

    <div 
      class="flex overflow-x-auto gap-4 py-4 scrollbar-hide scroll-smooth snap-x snap-mandatory px-4" 
      id={`${title.toLowerCase()}-container`}
    >
      <slot />
    </div>
  </div>
</section>
