---
type Props = { message: string; }
const { message } = Astro.props;

// We only need enough items to cover the initial viewport width + a little extra
const marqueeItems = Array(30).fill(message);
---

<section class="bg-red-600/80">
  <div class=" overflow-hidden py-2 relative text-black">

    <!-- Marquee content -->
    <div
      class="flex w-800 animate-marquee gap-1 text-4xl transition-all duration-2000 whitespace-nowrap font-black text-white tracking-none uppercase"
    >
      {
        marqueeItems.map((msg, index) => (
          <>
            <span>极简主义风格 注重功能性和简洁性 追求“少即是多”的设计理念</span>
          </>
        ))
      }
    </div>
  </div>
</section>