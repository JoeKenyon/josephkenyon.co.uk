---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  imageUrl: string;
  imageAsset?: any;
}

const { id, title, imageUrl, imageAsset } = Astro.props;
const isLocal = !imageUrl.startsWith('http');
---

<a href={`/music/${id}`} class="group gap-2 aspect-square border-0 flex flex-col invert-0 hover:invert-100 transition-all duration-300">
    <div class="overflow-hidden border-0 aspect-square shadowBox">
    {isLocal && imageAsset ? (
        <Image 
            src={imageAsset} 
            alt={title}
            class="w-full h-full object-cover aspect-square"
        />
    ) : (
        <img 
            src={imageUrl} 
            alt={title} 
            class="w-full h-full object-cover"
        />
    )}
    </div>
    <div class="flex flex-col gap-0 bg-white shadowBox">
        <h3 class="truncate px-2">{title}</h3>
    </div>
</a>
