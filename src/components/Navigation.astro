---
const pages = [
  { name: "home", href: "/" },
  { name: "projects", href: "/projects" },
  { name: "art", href: "/art" },
  { name: "music", href: "/music" },
];

const pathname = new URL(Astro.url).pathname;
const isActive = (path: string) => 
    path === "/" ? pathname === "/" : pathname.startsWith(path);
---


<nav class="
    font-black
    lowercase
    h-fit 

    lg:flex 
    lg:flex-col

    text-[6svw]

    lg:text-6xl

    flex flex-cols
    lg:gap-4
    justify-between

    max-w-full
">
    {pages.map((page, index) => (
    <a href={page.href} class={`${isActive(page.href) && "active"}`}>
        {page.name}
    </a>
    ))}
</nav>

<style>
a
{
    font-stretch: 200%;
    width: fit-content;


    background-color: white;

    :not(.active)&:hover
    {
        color: red;
    }

    &.active
    {
        color: red;
        font-weight: 900;
        transform: rotate(-1deg);
    }
}
</style>