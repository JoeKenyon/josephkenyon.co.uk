---
const pages = [
  { name: "home", href: "/" },
  { name: "projects", href: "/projects" },
  { name: "art", href: "/art" },
  { name: "music", href: "/music" },
];

const pathname = new URL(Astro.url).pathname;
const isActive = (path: string) => path === "/" ? pathname === "/" : pathname.startsWith(path);
---

<header class="sticky top-0 z-50 font-printer mb-5">
  <div id="menu-items" class="sm:w-fit sm: mx-auto w-full sm:gap-10 justify-between sm:flex sm:p-0 sm:items-center">
    {pages.map((page) => (
      <a href={page.href} class:list={["nav-link", { "active text-red-500": isActive(page.href) }]}>
        {page.name}
      </a>
    ))}
  </div>
</header>

<style>
@reference "tailwindcss";
.nav-link:not(.active)
{
  @apply block bg-black text-white text-3xl leading-none tracking-tighter hover:text-red-500 w-fit no-underline p-0 ;
}
.active
{
  @apply block bg-black text-3xl leading-none tracking-tighter hover:text-red-500 w-fit no-underline p-0 ;
}
</style>