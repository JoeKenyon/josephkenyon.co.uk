---
const pages = [
  { name: "home", href: "/" },
  { name: "projects", href: "/projects" },
  { name: "art", href: "/art" },
  { name: "music", href: "/music" },
];

const pathname = new URL(Astro.url).pathname;
const isActive = (path: string) => path === "/" ? pathname === "/" : pathname.startsWith(path);
---


<nav class="
flex 
sm:flex-row 
sm:flex-nowrap
flex-wrap
justify-around
lowercase 
gap-4
w-fit
max-w-screen
mx-auto 
pt-0">
    {pages.map((page) => (
    <a href={page.href} class={isActive(page.href) ? "active" : ""}>
        {page.name}
    </a>
    ))}
</nav>

<style>
@reference "tailwindcss";
a
{
    @apply bg-white text-[5.5svw] md:text-4xl;
    @apply drop-shadow-[5px_5px_0px] drop-shadow-black;
    &.active,:not(.active)&:hover{@apply text-pink-600;}
    &.active{@apply -rotate-2 origin-top bg-white;}
}
</style>