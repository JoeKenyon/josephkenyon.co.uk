---
import { getCollection, type DataEntryMap } from 'astro:content';
import { Image } from "astro:assets";
type Props = { collection: keyof DataEntryMap; }
const { collection } = Astro.props as Props;
const allPosts = await getCollection(collection);
---
<ul class="post-list">
	{allPosts.map(post => (
		<a class="post-list-link" href={`/${collection}/${post.id}`}>
			{post.data.thumbnail && ( <div class="thumbnail-wrapper"><Image class="post-list-thumbnail" src={post.data.thumbnail} alt={post.data.title} /></div>)}
			<div class="post-list-content">
			{post.data.title && ( <span class="post-list-title">{post.data.title}</span> )}
			</div>
		</a>
	))}
</ul>