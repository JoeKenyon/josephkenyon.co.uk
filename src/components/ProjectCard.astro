---
interface Props {
  id: string;
  title: string;
  description?: string;
}

const { id, title, description } = Astro.props;
---

<a class="shadowBox bg-white flex flex-col p-0 gap-0 no-underline hover:invert-100 invert-0 transition-all duration-100 " href={`/projects/${id}`}>
    <h2 class="text-xl font-bold">{title}</h2>
    {description && <h3 class="text-lg">{description}</h3>}
</a>
