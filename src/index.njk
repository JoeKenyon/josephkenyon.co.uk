---
layout: base.njk
title: "Home"
---
<header class="ticker">
    <h1>Projects</h1>
</header>

<ul>
    {%- for p in collections.projects -%}
        {%- if not p.data.external -%}
            <li class="is-writeup">
                <a class="" href="{{ p.url }}">{{ p.data.title | lower }}</a>
            </li>
        {%- endif -%}
    {%- endfor -%}
    <hr>
    {%- for p in collections.projects -%}
        {%- if p.data.external -%}
            <li class="is-external">
                <a href="{{ p.data.external }}" target="_blank" rel="noopener">{{ p.data.title | lower }} ↗</a>
            </li>
        {%- endif -%}
    {%- endfor -%}
</ul>