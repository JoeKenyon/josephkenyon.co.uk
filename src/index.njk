---
layout: base.njk
title: "Home"
---
<h1>Projects</h1>
<ul>
    {%- for p in collections.projects -%}
        {%- if not p.data.external -%}
            <li class="is-writeup">
                <a class="" href="{{ p.url }}">{{ p.data.title | lower }}</a>
            </li>
        {%- endif -%}
    {%- endfor -%}
    {%- for p in collections.projects -%}
        {%- if p.data.external -%}
            <li class="is-external">
                <a href="{{ p.data.external }}" target="_blank" rel="noopener">>{{ p.data.title | lower }}</a>
            </li>
        {%- endif -%}
    {%- endfor -%}
</ul>

<h1>Music</h1>
<ul>
    {% for m in collections.music %}
        <li>
            <a href="{{ m.data.url }}" target="_blank">{{ m.data.title }}</a>
        </li>
    {% endfor %}
</ul>

<h1>Demos</h1>
<ul>
    {%- for d in collections.misc_music %}
        <li>
            <audio class="player" controls preload="metadata">
                <source src="{{ d.url }}">
            </audio>
        </li>
    {% endfor %}
</ul>
<h1>Links</h1>
<div class="links">
    <a class="" href="https://www.youtube.com/@joekenyon" target="_blank">YouTube</a>
    <a class="" href="https://joekenyon72.bandcamp.com" target="_blank">Bandcamp</a>
    <a class="" href="https://open.spotify.com/artist/6sUGdqO5gMEYlSLHyzYo0f" target="_blank" rel="noopener">Spotify</a>
    <a class="" href="mailto:joekenyon72@gmail.com" target="_blank">Email</a>
    <a class="" href="https://github.com/joekenyon" target="_blank" rel="noopener">GitHub</a>
</div>
<h1>Art</h1>
<div class="moe-zay-ick">
    {% for image in collections.artImages %}
    <img src="{{ image.url }}" alt="{{ image.alt }}" loading="lazy" decoding="async">
    {% endfor %}
</div>