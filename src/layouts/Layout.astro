---

interface Props {
	title: string;
	description?: string;
}

import Header from '../components/Header.astro';

const pathname = new URL(Astro.url).pathname;
const isActive = (path: string) => path === "/" ? pathname === "/" : pathname.startsWith(path);

const { title, description } = Astro.props;

const links = [
	{ "name": "LinkedIn" , "url": "https://www.linkedin.com/in/joe-kenyon/" },
	{ "name": "Instagram", "url": "https://instagram.com/kenyon_joe" },
	{ "name": "GitHub"   , "url": "https://github.com/JoeKenyon" },
	{ "name": "Email"    , "url": "mailto:joekenyon72@gmail.com"}
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="imgs/art/camo camo kes.png">
		<title>Joseph Kenyon | {title}</title>
		<style is:global>
			:root 
			{
				--bg: #141414;
				--text: #dedede;
				--accent: #ff69b4;
				--accent: rgb(248, 46, 147);
			}
			html
			{
				font-size: 9.5px;
			}
			body 
			{
				font-family: system-ui, sans-serif;
				font-family: monospace;
				margin: 0;
				padding: 2rem;
				line-height: 1.5rem;
				color: var(--text);
				background: var(--bg);
				max-width: 650px;
				margin: 0 auto;
			}
			a
			{ 
				background-color: rgba(0, 0, 0, 0.394);

				text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);

				transition: all ease-in-out 300ms;
				color: var(--accent); 
				&:hover
				{
					opacity:1;
					text-decoration-color: transparent;
					background-color: var(--accent);
					color: black;
				}
			}
			p > img 
			{ 
				max-width: 100%; 
				height: auto; 
				background: white;
				max-height: 90svh;
				width: auto;
				height: 100%;
				display: flex;
				margin: 1rem auto;
			}
			#bg
			{ 
				position: fixed; 
				inset: 0; 
				pointer-events: none;
				z-index: -1; 
				opacity: 0.05;
				background-image: url("/imgs/UI-design.svg");
				background-size: cover;
				background-position: top;
				filter: invert(1);
			}
			footer
			{
				padding: 2rem; 
				margin: 0 auto; 
				width: fit-content; 
				gap: 1rem; 
				display: flex;
				flex-direction: columns;
				height: fit-content;

				& > a
				{
					height: fit-content;
					padding: 0;
					margin: 0;
				}
			}
		</style>
	</head>
	<body>
		<div id="bg"/>
		<Header/>
		<main>
			<slot />
		</main>
		<footer>
		{
			links.map((link) => (<a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>))
		}
		</footer>
	</body>
</html>

<style>
</style>
