---
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Navigation from "@components/Navigation.astro";
import Background from "@components/Background.astro";
type Props = { title: string; }
const { title } = Astro.props;

const pathname = new URL(Astro.url).pathname;
const segments = pathname.split('/').filter(Boolean);
const baseSegment = segments[0] || "home";
const routeLabels: Record<string, string> = 
{
    "home": "Home",
    "projects": "Projects",
    "music": "Music",
    "art": "Art"
};
const displayTitle = routeLabels[baseSegment] || title;
---

<!doctype html>
<html lang="en">
	<Head title={title}/>
<body class="mx-auto border-white/20 lg:max-w-5xl md:max-w-xl">
<!-- <body class="mx-auto max-w-7xl border-x border-white/20 2xl:max-w-7xl"> -->
    <Background/>

    <Navigation/>

    <main>
        <slot/>
    </main>

    <Footer/>

</body>
