---
import Footer from "@components/Footer.astro";
import Head from "@components/Head.astro";
import Navigation from "@components/Navigation.astro";
import SuperHeading from "@components/SuperHeading.astro";
type Props = { title: string; }
const { title } = Astro.props;

const pathname = new URL(Astro.url).pathname;
const segments = pathname.split('/').filter(Boolean);
const baseSegment = segments[0] || "home";
const routeLabels: Record<string, string> = 
{
    "home": "Home",
    "projects": "Projects",
    "music": "Music",
    "art": "Art"
};
const displayTitle = routeLabels[baseSegment] || title;
---

<!doctype html>
<html lang="en">
	<Head title={title}/>
<body class="h-dvh flex flex-col p-1 w-full overflow-hidden overscroll-none"> 

    <div id="bg" transition:persist />

	<SuperHeading>{displayTitle}</SuperHeading>

    <div class="shrink-0 p-4 sticky top-0 z-10">
        <Navigation/>
    </div>

    <main id="main-content" class="flex-1 overflow-y-auto overscroll-contain" transition:animate="slide">
        <slot/>
    </main>

    <div class="shrink-0">
        <Footer/>
    </div>
</body>
