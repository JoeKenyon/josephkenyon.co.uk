---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import PostNavigation from "../components/PostNavigation.astro";
import { type DataEntryMap } from 'astro:content';

type Props = { 
    title: string; 
    seoTitle?: string;
    collection?: keyof DataEntryMap;
}
const { title, seoTitle, collection } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
    <BaseHead title={seoTitle || title}/>
    
    <body transition:persist>
        <div class="site-wrapper" transition:animate="slide">
            <Header/>
            <main class="site-main">
                <div class="page-content">
                    <h1 class="page-title">{ title }</h1>
                    <slot/>
                </div>
                {collection && <PostNavigation collection={collection}/>}
            </main>
            <Footer/>
        </div>
    </body>
</html>

