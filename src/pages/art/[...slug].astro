---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ArtLayout from '@layouts/ArtLayout.astro';
import ArtNavigation from '@components/ArtNavigation.astro';

export const prerender = true;

export async function getStaticPaths() 
{
  const artEntries = await getCollection('art');
  const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/*.{jpeg,jpg,png,webp,svg}', { eager: true });
  
  // Sort them however you like (e.g., by title or date)
  const sortedArt = artEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));

  return sortedArt.map((entry, i) => {
    const imagePath = `/src/assets/art/${entry.data.imageName}`;
    const imageAsset = images[imagePath]?.default;

    return {
      params: { slug: entry.id },
      props: { 
        entry,
        imageAsset,
        // Pass the slugs for the neighbors
        prev: i > 0 ? sortedArt[i - 1].id : sortedArt[sortedArt.length - 1].id,
        next: i < sortedArt.length - 1 ? sortedArt[i + 1].id : sortedArt[0].id
      },
    };
  });
}

const { entry, prev, next, imageAsset } = Astro.props;
const title = "Art";
---
<ArtLayout title={title}>
    {/* 1. We force the art container to be exactly the height of its parent (main) */}
    <div id="art-navigation" data-prev={prev} data-next={next} class="h-full border-0 flex flex-col p-0 gap-0 w-full">
        
        <h1 class="pageTitle max-w-2xl w-full shrink-0 text-center overflow-hidden break-all h-10">
            {entry.data.title}
        </h1>

        <ArtNavigation prev={prev} next={next} />

        <div class="min-h-0 max-w-full bg-transparent w-full">
            {imageAsset && ( 
                <Image 
                    src={imageAsset} 
                    alt={entry.data.title} 
                    width={1200}
                    quality="high"
                    class="max-h-full mx-auto object-contain shadowBox bg-white border"
                />
            )}
        </div>
    </div>
</ArtLayout>

<style is:global>
  /* 
     This targets the 'main' tag inside Layout.astro 
     and disables scrolling JUST for this page.
  */
  #main-content {
    overflow: hidden !important;
  }
</style>

<script>
// Client-side script to handle key presses
const nav = document.querySelector('#art-navigation');
const prevSlug = nav?.getAttribute('data-prev');
const nextSlug = nav?.getAttribute('data-next');

document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' && prevSlug) {
        window.location.href = `/art/${prevSlug}`;
    } else if (e.key === 'ArrowRight' && nextSlug) {
        window.location.href = `/art/${nextSlug}`;
    }
});
</script>
