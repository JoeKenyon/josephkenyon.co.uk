---
import { render } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollectionPaths } from "@lib";
import { Image } from 'astro:assets';
export const prerender = true;

export async function getStaticPaths()
{ 
	return await getCollectionPaths('art');
}

const art = Astro.props;
const { Content } = await render(art);
---

<MainLayout title={art.data.title} collection="art">
	{art.data.thumbnail && (
		<div class="artwork-full">
            <Image src={art.data.thumbnail} width={1200} alt={art.data.title} />
		</div>
	)}
    <Content/>
</MainLayout>