import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// 1. Use the new Art Collection instead of artData json
const allProjects = await getCollection('projects');
const allArt = await getCollection('art');

const featuredProjects = allProjects.slice(0, 3);
// Get the first 6 pieces of art from the collection
// Shuffle and pick 6
// 1. Filter out SVGs FIRST so they don't take up a slot
const validArt = allArt.filter(art => !art.data.imageName.endsWith('.svg'));

// 2. Shuffle the clean list
function shuffle(array: any[]) {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
}

// 3. Now slice 6 from a list that ONLY contains valid images
const featuredArt = shuffle([...validArt]).slice(0, 6);

// Get image metadata eagerly
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/*.{jpeg,jpg,png,gif,webp,svg}', { eager: true });

const skills = [
	"C++", "C", "C#", "Embedded Systems", "DSA", "STM32",
	"DSP", "Audio Programming", "JUCE", "HTML/CSS", "JS", "ReactJS"
];
