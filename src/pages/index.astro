---
import Layout from '@layouts/Layout.astro';
import Marquee from '@components/Marquee.astro';
const title = "Home";
---
<Layout title={title}>
    <h2 class="text-white leading-none tracking-tighter text-justify font-black uppercase text-3xl lg:text-8xl relative">
        Joseph Kenyon
    </h2>
    <h1
    class="text-white leading-none tracking-tighter text-justify font-black uppercase text-3xl lg:text-8xl relative"
    >
        Artist, musician, and developer based in Cambridge, UK.
    </h1>
    <Marquee message={title} />
</Layout>
