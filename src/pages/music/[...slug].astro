---
import { render } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollectionPaths } from "@lib";
import { Image } from 'astro:assets';

export async function getStaticPaths()
{ 
	return await getCollectionPaths('music');
}

const music = Astro.props;
const { Content } = await render(music);
---

<MainLayout title={music.data.title} collection="music">
	{music.data.thumbnail && (
		<div class="album-cover-wrapper">
			<Image class="album-cover" src={music.data.thumbnail} width={1000} alt={music.data.title} />
		</div>
	)}
	<div class="music-tracks">
		{music.data.tracks.map(track => (
			<iframe 
			class="music-track-iframe"
			src={`https://bandcamp.com/EmbeddedPlayer/track=${track.id}/size=medium/linkcol=333333/bgcol=ffffff/transparent=true/`}
			loading="lazy"
			/>
		))}
    </div>
</MainLayout>

<style>
.album-cover-wrapper {
    margin-top: 0.8rem;
    width: 100%;
}

.album-cover {
    width: 100%;
    max-height: 400px;
    object-fit: contain;
}

.music-tracks {
    display: flex;
    flex-direction: column;
    width: 100%;
    align-items: center;

    .music-track-iframe {
        margin-top: 0.8rem;
        max-height: 120px;
        max-width: 700px;
        height: 100%;
        width: 100%;
        border: none;
    }
}
</style>