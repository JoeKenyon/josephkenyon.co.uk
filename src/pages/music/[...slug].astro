---
import { render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { getCollectionPaths } from "@lib";
import { Image } from 'astro:assets';
import Container from '@components/Container.astro';

export const prerender = true;

export async function getStaticPaths()
{ 
	return await getCollectionPaths('music');
}

const release = Astro.props;
const { Content } = await render(release);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/music/*.{jpeg,jpg,png,webp}', { eager: true });
const imagePath = `/src/assets/music/${release.data.imageUrl}`;
---

<Layout title={release.data.title} description={release.data.title}>
	<Container>
	
		
		
		{images[imagePath] && (
			<div class="flex flex-col w-full max-w-[700px] mx-auto gap-4">
				<h4 class="mb-0">{release.data.title}</h4>
				<Image src={images[imagePath].default} alt={release.data.title} class="object-contain w-auto h-[40%] max-h-[65svh] max-w-full" />
			</div>
			)}
		
		
		<div class="flex flex-col w-full max-w-[700px] mx-auto gap-4">
			<h5 class="mt-4">Tracks</h5>
			{release.data.tracks.map((track,i) => (
				<>
				<iframe class="w-full h-full rounded-none border-none max-w-[700px] max-h-[120px]" src={`https://bandcamp.com/EmbeddedPlayer/track=${track.id}/size=medium/linkcol=ff69b4/bgcol=f13400/transparent=true/`}/>
				</>
			))}
		</div>
    </Container>
</Layout>

