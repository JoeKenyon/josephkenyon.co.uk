---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import Container from '@components/Container.astro';
import MusicIcon from '@components/Titles/MusicIcon.astro';

const music = await getCollection('music');
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/music/*.{jpeg,jpg,png,webp,svg}', { eager: true });
---

<Layout title="Music" description="Music projects and releases by Joseph Kenyon">
    <Container>
      <section class="py-0 animate">
        <div class="flex items-end gap-4 mb-12">
          <h1 class="text-9xl font-bold tracking-tighter mb-4">Music</h1>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
          {music.map((release) => {
              const imagePath = `/src/assets/music/${release.data.imageUrl}`;
              const isLocal = !release.data.imageUrl.startsWith('http');
              const imageAsset = isLocal ? images[imagePath] : null;

              return (
                  <a href={`/music/${release.id}`} class="group flex flex-col gap-3">
                      <div class="aspect-square overflow-hidden bg-white/5 border border-white/5 group-hover:border-accent transition-all">
                        {isLocal && imageAsset ? (
                          <Image 
                            src={imageAsset.default} 
                            alt={release.data.title} 
                            width={400}
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                        ) : (
                          <img 
                            src={release.data.imageUrl} 
                            alt={release.data.title} 
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                        )}
                      </div>
                      <div class="flex flex-col gap-0.5">
                        <h3 class="text-sm font-bold truncate group-hover:text-accent transition-colors">{release.data.title}</h3>
                        <p class="text-[10px] uppercase tracking-widest opacity-50">{release.data.source}</p>
                      </div>
                  </a>
              )
          })}
        </div>
      </section>
    </Container>
</Layout>
