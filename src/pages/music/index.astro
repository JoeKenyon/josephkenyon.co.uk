---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import MusicCard from '@components/MusicCard.astro';
const music = await getCollection('music');
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/music/*.{jpeg,jpg,png,webp,svg}', { eager: true });
const title = "Music";
---
<Layout title={title}>
<section class="py-0 animate">
    <div class="grid sm:grid-cols-2 md:grid-cols-3 grid-cols-1 gap-5">
        {music.map((release, index) => {
            const imagePath = `/src/assets/music/${release.data.imageUrl}`;
            const isLocal = !release.data.imageUrl.startsWith('http');
            const imageAsset = isLocal ? images[imagePath]?.default : null;

            return (
                <MusicCard 
                    id={release.id} 
                    title={release.data.title} 
                    imageUrl={release.data.imageUrl} 
                    imageAsset={imageAsset} 
                    loading={index < 3 ? "eager" : "lazy"}
                />
            )
        })}
    </div>
</section>
</Layout>
