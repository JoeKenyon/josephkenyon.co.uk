---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
const title = "Projects";
const collection = await getCollection('projects');
---
<Layout title={title}>
<div class="flex flex-col gap-10 lg:max-w-5xl md:max-w-xl mx-auto">
    {Object.values(collection).map((entry) => (
        <a href={`/projects/${entry.id}`} class="flex flex-col hover:invert gap-0 bg-black">
                <h1
    class="text-white leading-none tracking-tighter font-black uppercase text-3xl lg:text-5xl relative"
    >{entry.data.title}</h1>
                <h1
    class="text-white leading-none tracking-wide font-black lowercase italic text-3xl lg:text-5xl relative"
    >{entry.data.description}</h1>
        </a>
    ))}
</div>
</Layout>
